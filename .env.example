# Copy to .env.local and fill in to use Supabase instead of localStorage.
# See DEPLOY.md for how to get these values.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Hardcover link (set these in Vercel only; NEVER prefix with VITE_) ---
# HARDCOVER_API_TOKEN=        your token from hardcover.app/settings
# HARDCOVER_ALLOWED_EMAIL=    your Ad Astra login email (only this account may use the Hardcover function)
